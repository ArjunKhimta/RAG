{
  "name": "code-search-api",
  "version": "0.1.0",
  "description": "Node API for the code search engine: sign-in, users, repositories, chat history, and limits",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "supertest": "7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
